#version 450

// a display transfer between two surfaces, like the CPU does it
// both images hold rows bottom first, so a buffer's row y is image row height minus 1 minus y,
// and the input can start some rows into its surface
// each pixel gets quantized to the input format, averaged over its block, then quantized to the output format,
// since memory would hold the pixels in those formats
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D source;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;

layout(push_constant) uniform Transfer {
    // the pixels written, width and height
    ivec2 size;
    int input_height;
    int output_height;
    ivec2 scale;
    int flip;
    int input_format;
    int output_format;
    // the surface row the input starts at, and the surface's height
    int source_row;
    int source_height;
    // drawn scaled, the scale when the output's texels are to come out as the console's (see main), else 0
    int footprint;
} transfer;

uint expand(uint value, uint bits) {
    return (value << (8u - bits)) | (value >> (2u * bits - 8u));
}

// what a pixel becomes once stored in a format and read back
uvec4 quantize(uvec4 c, int format) {
    switch (format) {
    case 0:
        return c;
    case 1:
        return uvec4(c.rgb, 255u);
    case 2:
        return uvec4(expand(c.r >> 3, 5u), expand(c.g >> 2, 6u), expand(c.b >> 3, 5u), 255u);
    case 3:
        return uvec4(expand(c.r >> 3, 5u), expand(c.g >> 3, 5u), expand(c.b >> 3, 5u), c.a >= 128u ? 255u : 0u);
    default:
        return (c >> 4) * 17u;
    }
}

// an output texel of the console's, the average of the whole block of input it covers, at that scale
vec4 console_texel(ivec2 texel) {
    int n = transfer.footprint;
    uvec4 sum = uvec4(0u);
    for (int dy = 0; dy < transfer.scale.y * n; dy++) {
        for (int dx = 0; dx < transfer.scale.x * n; dx++) {
            int x = texel.x * transfer.scale.x * n + dx;
            int y = texel.y * transfer.scale.y * n + dy;
            if (transfer.flip != 0) {
                y = transfer.input_height - 1 - y;
            }
            int row = transfer.source_height - 1 - (transfer.source_row + y);
            sum += quantize(uvec4(round(imageLoad(source, ivec2(x, row)) * 255.0)), transfer.input_format);
        }
    }
    uint count = uint(transfer.scale.x * transfer.scale.y * n * n);
    return vec4(quantize((sum + count / 2u) / count, transfer.output_format));
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= transfer.size.x || at.y >= transfer.size.y) {
        return;
    }
    // a texture made smaller to be blurred (a bloom) holds the console's texels, filtered across the scaled ones,
    // averaging only its own few pixels it'd keep all the detail drawn scaled, and the blur would show copies instead
    if (transfer.footprint > 1) {
        int n = transfer.footprint;
        ivec2 texels = transfer.size / n;
        vec2 p = (vec2(at) + 0.5) / float(n) - 0.5;
        ivec2 low = ivec2(floor(p));
        vec2 f = p - vec2(low);
        ivec2 a = clamp(low, ivec2(0), texels - 1);
        ivec2 b = clamp(low + 1, ivec2(0), texels - 1);
        vec4 top = mix(console_texel(a), console_texel(ivec2(b.x, a.y)), f.x);
        vec4 bottom = mix(console_texel(ivec2(a.x, b.y)), console_texel(b), f.x);
        imageStore(target, ivec2(at.x, transfer.output_height - 1 - at.y), round(mix(top, bottom, f.y)) / 255.0);
        return;
    }
    uvec4 sum = uvec4(0u);
    for (int dy = 0; dy < transfer.scale.y; dy++) {
        for (int dx = 0; dx < transfer.scale.x; dx++) {
            int x = at.x * transfer.scale.x + dx;
            int y = at.y * transfer.scale.y + dy;
            if (transfer.flip != 0) {
                y = transfer.input_height - 1 - y;
            }
            int row = transfer.source_height - 1 - (transfer.source_row + y);
            vec4 texel = imageLoad(source, ivec2(x, row));
            sum += quantize(uvec4(round(texel * 255.0)), transfer.input_format);
        }
    }
    uint count = uint(transfer.scale.x * transfer.scale.y);
    uvec4 pixel = quantize((sum + count / 2u) / count, transfer.output_format);
    imageStore(target, ivec2(at.x, transfer.output_height - 1 - at.y), vec4(pixel) / 255.0);
}
