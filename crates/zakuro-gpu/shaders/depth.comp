#version 450

// a texture that's rows of a depth buffer, read as colors like a title reads the buffer's bytes
// the depth and stencil come copied into buffers, a word and a byte per sample, in the image's rows, bottom first
// d24s8 samples read as rgba8 give the stencil, then the depth's high, middle and low bytes,
// d24 samples read as rgb8 give the depth's bytes
// a GPU that can't draw 24 bit depth gives 32 bit floats for the words
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) readonly buffer Depths { uint depths[]; };
layout(set = 0, binding = 1) readonly buffer Stencils { uint stencils[]; };
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D target;

layout(push_constant) uniform Copy {
    // the texture's width and height
    ivec2 size;
    // the surface's width and height, and the row the texture starts at
    int surface_width;
    int surface_height;
    int source_row;
    // do samples carry stencil, and is the texture rgba8
    int stencil;
    // are the words floats
    int floats;
} copy;

// the 24 bits nearest a float depth, a half going up, exactly like d24_from_float works them out on the CPU
// depth * 2^24 is exact, and depth * (2^24 minus 1) is that minus depth
// from a half up the product is whole and the depth takes between a half and one off it,
// below a half the depth is less than the product's step,
// so it only moves the fraction across a half from above one
uint d24(float depth) {
    if (!(depth > 0.0)) {
        return 0u;
    }
    if (depth >= 1.0) {
        return 0xFFFFFFu;
    }
    precise float scaled = depth * 16777216.0;
    precise float whole = floor(scaled);
    if (depth >= 0.5) {
        return uint(whole) - (depth > 0.5 ? 1u : 0u);
    }
    return uint(whole) + (scaled - whole > 0.5 ? 1u : 0u);
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (at.x >= copy.size.x || at.y >= copy.size.y) {
        return;
    }
    int row = copy.surface_height - 1 - (copy.source_row + at.y);
    int index = row * copy.surface_width + at.x;
    uint depth = copy.floats != 0 ? d24(uintBitsToFloat(depths[index])) : depths[index] & 0xFFFFFFu;
    uvec3 bytes = uvec3(depth >> 16, depth >> 8, depth) & 0xFFu;
    uvec4 color;
    if (copy.stencil != 0) {
        uint stencil = (stencils[index >> 2] >> ((index & 3) * 8)) & 0xFFu;
        color = uvec4(stencil, bytes);
    } else {
        color = uvec4(bytes, 255u);
    }
    // the texture's rows run top first
    imageStore(target, ivec2(at.x, at.y), vec4(color) / 255.0);
}
